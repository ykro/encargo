{
  "name": "encargo-pulso",
  "private": true,
  "description": "Pulso: a stunning store readable only by humans (client-side rendering, facts inside images). Control mode (PULSO_AGENT_READY=true) publishes the same machine-readable layer as Kilómetro.",
  "scripts": {
    "sync": "node ../sync-shared.mjs && node scripts/build-vitrina.mjs",
    "predev": "npm run sync",
    "dev": "STORE_KEY=pulso next dev -p 3002",
    "prebuild": "npm run sync",
    "build": "next build",
    "start": "next start -p ${PORT:-3002}",
    "typecheck": "npm run sync && tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.3"
  }
}
