# Encargo — copy to .env (never commit .env). Every model comes from here.

# Google Cloud / Vertex AI (ADC: `gcloud auth application-default login`)
GOOGLE_CLOUD_PROJECT=ai-experiments-487722
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_VERTEXAI=true

# Models (no model name is hard-coded in the code)
GEMINI_MODEL=gemini-3.8-flash
IMAGE_MODEL=gemini-3.1-flash-lite-image

# 1 = deterministic planner instead of Gemini (tests, rehearsals without network)
MOCK_AI=0

# Agent service
AGENT_PUBLIC_URL=http://localhost:8000
STORE_URLS=http://localhost:3002,http://localhost:3001
RUN_STORE=memory            # memory | firestore
FIRESTORE_DATABASE=encargo
RUN_TIMEOUT_S=110
BROWSER_ENABLED=1
# Test-mode AP2 signer: the person's device holds this token (Phase 2: passkey)
SIGNER_MODE=test
HUMAN_APPROVAL_TOKEN=change-me-human
# Optional: stable platform mandate key (private EC P-256 JWK). Generated per process if empty.
PLATFORM_SIGNING_JWK=

# Stores
ADMIN_TOKEN=dev-admin
PULSO_AGENT_READY=false
# Platforms allowed to sign mandates (their /.well-known/ucp)
TRUSTED_PLATFORM_PROFILES=http://localhost:8000/.well-known/ucp
# Optional: stable merchant key (private EC P-256 JWK). Generated per process if empty.
MERCHANT_SIGNING_JWK=
